{
  "name": "luyentuvacau",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --exclude scripts/architecture-validation.test.mjs --exclude scripts/validate-stage2-security.test.mjs --exclude scripts/validate-stage2-delivery.test.mjs",
    "validate": "npm run validate:content",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "validate:stage2-security": "node scripts/validate-stage2-security.mjs",
    "test:stage2-security": "node --test scripts/validate-stage2-security.test.mjs",
    "validate:stage2-delivery": "node scripts/validate-stage2-security.mjs --delivery",
    "test:stage2-delivery": "node --test scripts/validate-stage2-delivery.test.mjs",
    "test:architecture": "node --test scripts/architecture-validation.test.mjs",
    "validate:css": "node scripts/validate-css-tokens.mjs",
    "check": "npm run validate:content && npm run validate:architecture && npm run test:architecture && npm run validate:stage2-security && npm run test:stage2-security && npm run validate:stage2-delivery && npm run test:stage2-delivery && npm run validate:css && npm run lint && npm run test && npm run build && node scripts/assert-build.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  }
}



